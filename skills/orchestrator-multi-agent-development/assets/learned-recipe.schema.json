{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AllanHarlen/cc-orchestrador-subagents/schemas/learned-recipe.schema.json",
  "title": "Validated learned recipe",
  "type": "object",
  "required": [
    "id", "version", "status", "pinned", "needsReview", "confidence",
    "trigger", "action", "reason", "sourceRun", "evidence", "useCount",
    "successCount", "failureCount", "createdAt", "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,100}$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ACTIVE", "STALE", "ARCHIVED"] },
    "pinned": { "type": "boolean" },
    "needsReview": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "trigger": { "type": "object", "minProperties": 1 },
    "action": { "type": "object", "minProperties": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "sourceRun": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "useCount": { "type": "integer", "minimum": 0 },
    "successCount": { "type": "integer", "minimum": 0 },
    "failureCount": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lastUsedAt": { "type": ["string", "null"], "format": "date-time" },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
